# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tradiary?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Cloudinary (screenshot + avatar uploads) ────────────────────────────────
# Dashboard → https://cloudinary.com/console → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Brevo Transactional API) ─────────────────────────────────────────
# Dashboard → Settings → SMTP & API → API Keys → Create API key
# EMAIL_FROM_ADDRESS must be a verified sender in Brevo (Settings → Senders & IPs)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_NAME=Tradiary
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Production: set to your Vercel URL e.g. https://tradiary.app
CLIENT_ORIGIN=http://localhost:5173

# ─── Cron jobs ────────────────────────────────────────────────────────────────
# Weekly summary notification schedule (cron expression, UTC)
# Default: every Sunday at 08:00 UTC — '0 8 * * 0'
# Only runs when NODE_ENV=production
WEEKLY_SUMMARY_CRON=0 8 * * 0

# ─── Market data (Trade Replay) ───────────────────────────────────────────────
# Controls which provider backs the Trade Replay candlestick chart.
# 'yahoo'   → Yahoo Finance unofficial endpoint (default — keyless, all asset classes)
# 'binance' → Binance public REST (keyless, crypto only; ignored for stocks/forex)
# Future: set to 'twelvedata' and add TWELVE_DATA_API_KEY once you have a key.
MARKET_DATA_PROVIDER=yahoo
