# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tradiary?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Cloudinary (screenshot uploads — Prompt 02+) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Brevo API) ────────────────────────────────────────────────────────
# Uses Brevo Transactional Email API over HTTPS — works on Render free tier.
# BREVO_API_KEY: dashboard → Settings → SMTP & API → API Keys → Create a new API key
# EMAIL_FROM_ADDRESS must be a verified sender in Brevo (Settings → Senders & IPs → Senders)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_NAME=Tradiary
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
